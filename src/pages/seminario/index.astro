---
import Layout from "../../layouts/Layout.astro";
import Cronograma from "./Cronograma.astro";
import Patrocinadores from "../../components/inicio/Patrocinadores.astro";
import Header from "./header.astro";
import CardPonente from "../../components/ponentes/cardPonente.astro";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const { pageTitle, pageDescription, OGImage } = staticData.data;

const ponentes = [
  {
    nombre: "M.Sc. Jorge Leoncio Guerra Guerra",
    tema: "Desarrollo de Aplicaciones Usando IA Generativa",
    universidad: "UNMSM",
    foto: "/ponentes/GuerraGuerra.png",
    biografia: "El M.Sc. Jorge Leoncio Guerra Guerra es Docente investigador de la Facultad de Ingeniería de Sistemas e Informática de la Universidad Nacional Mayor de San Marcos. Es Investigador RENACYT por UNMSM, Miembro del grupo de Investigación de Internet de las Cosas UNMSM, y Evaluador de proyectos para CONCYTEC y PROINNOVATE. Sus líneas de investigación incluyen Sistemas Distribuidos, Industria 4.0, Internet de las Cosas y Smart City. Ha presentado ponencias en eventos como CLEI, INSOVIÑA, IEEE INTERCON, CONEISC, COREIS y tiene artículos aceptados en IEEE INTERCON, SIMBIG y ACM ITICSE.",
    bandera: "/banderas/peru.png"
  },
  {
    nombre: "Dr. Diodomiro Baldomero Luque Carcasi",
    tema: "Módulo Educacional de Internet Das Coisas para Aplicações na Amazônia",
    universidad: "UFAC",
    foto: "/ponentes/LuqueCarcasi.png",
    biografia: "El Dr. Diodomiro Baldomero Luque Carcasi es actualmente profesor asociado de la Universidad Federal del Acre (UFAC), y miembro titular de los programas de posgrado en Ciencias de la Computación e Ingeniería Eléctrica. Es especialista en las áreas de proyecto electromagnético de máquinas con imán permanente, Electrónica de Potencia, Energías Renovables e Inteligencia Artificial. Realizó un Post-Doctorado en la 'Universidad Federal do ABC' orientado a redes inteligentes (Smart Grids). Además, fue asesor principal de la Comisión de Ciencia, Innovación y Tecnología del Congreso de la República del Perú y es revisor de trabajos científicos en diversas áreas.",
    bandera: "/banderas/brasil.png"
  },
  {
    nombre: "Dr. Miguel Ángel Valles Coral",
    tema: "Estimación No Invasiva del Peso en Ganado Vacuno mediante Modelos Híbridos de Segmentación de Imágenes y Regresión",
    universidad: "UNSM",
    foto: "/ponentes/VallesCoral.png",
    biografia: "El Dr. Miguel Ángel Valles Coral es Ingeniero de Sistemas, Docente Universitario Asociado en la Facultad de Ingeniería de Sistemas e Informática de la UNSM, y cuenta con el Nivel III del RENACYT. Es Editor en Jefe de la Revista Científica de Sistemas e Informática indexada en SCOPUS. Sus publicaciones en revistas indexadas en Scopus y WoS abarcan temas como el uso de algoritmos de aprendizaje automático en psicología y diagnóstico médico. Ha liderado proyectos como el desarrollo de un prototipo de selección de café con reconocimiento de imágenes.",
    bandera: "/banderas/peru.png"
  },
  {
    nombre: "Dra. Ana Beatriz Álvarez Mamani",
    tema: "A Visão e Inteligência Computacional como Fator Promotor da Transformación Digital",
    universidad: "UFAC",
    foto: "/ponentes/AlvarezMamani.png",
    biografia: "La Dra. Ana Beatriz Álvarez Mamani es Profesora Titular del Centro de Ciencias Exactas y Tecnológicas de la Universidad Federal de Acre (UFAC) Brasil. Es Coordinadora General del Proyecto Lab de Investigación Aplicada en Visión e Inteligencia Computacional, una colaboración entre UFAC, Motorola, Flextronics y Fundape. Es Licenciada, Máster y Doctora en Ingeniería Eléctrica. Sus áreas de experiencia incluyen Inteligencia Computacional, Visión por Computadora, Sistemas de Control y Automatización. Realizó prácticas doctorales en la Universidad de Alcalá de Henares y becas postdoctorales en la Universidad Estatal de Campinas y la Universidad Nacional de San Antonio Abad del Cusco.",
    bandera: "/banderas/brasil.png"
  },
  {
    nombre: "Dr. Yalmar Temistocles Ponce Atencio",
    tema: "Inteligencia Artificial en Sectores Estratégicos: Salud, Educación, Minería y Seguridad",
    universidad: "UNAJ",
    foto: "/ponentes/PonceAtencio.png",
    biografia: "El Dr. Yalmar Temistocles Ponce Atencio es Ingeniero de Sistemas por la Universidad Nacional del Altiplano. Posee Maestría y Doctorado en Ingeniería de Sistemas y Computación por la Universidad Federal de Rio de Janeiro, Brasil. Actualmente trabaja en la escuela profesional de ingeniería de software y sistemas en la Universidad Nacional de Juliaca - Puno, donde se enfoca en el uso y desarrollo de Inteligencia Artificial para diferentes áreas del conocimiento. Participa como revisor y ponente en eventos científicos nacionales e internacionales.",
    bandera: "/banderas/peru.png"
  },
  {
    nombre: "Dr. Víctor Andrés Ayma Quirita",
    tema: "Aplicaciones de IA en Remote Sensing",
    universidad: "PUCP / UP",
    foto: "/ponentes/AymaQuirita.png",
    biografia: "El Dr. Víctor Andrés Ayma Quirita es Profesor en la Universidad del Pacífico y en la Escuela de Posgrado de la Pontificia Universidad Católica del Perú (PUCP). Es Investigador Nivel I dentro del Grupo Maria Rostworowski y obtuvo la distinción de 'Investigador REGINA' del CONCYTEC. Es Miembro Senior del IEEE. Sus áreas de especialización incluyen procesamiento digital de imágenes, teledetección, big data, aprendizaje automático y visión artificial. Fue investigador visitante en la Universidad de Extremadura, España, concentrándose en métodos de clasificación de imágenes hiperespectrales.",
    bandera: "/banderas/peru.png"
  }
]
---

<div class="w-full h-20"></div>

<Layout
  pageTitle={pageTitle}
  description={pageDescription}
  ogimage={{ alt: OGImage.alt, url: OGImage.url }}
>
  <Header />

  <div class="flex flex-col items-center justify-center text-center pt-8 pb-2">
    <h1 class="text-4xl md:text-6xl font-bold text-purple-900 dark:text-purple-400 mb-6">
        Ponentes
      </h1>
  </div>

  <section class="flex flex-wrap md:flex-row flex-col gap-6 justify-center items-center mb-20 mx-8 relative">
    {
      ponentes.map((ponente) => (
        <CardPonente {...ponente} />
      ))
    }

  </section>
  <Cronograma />
  <Patrocinadores />
  <!-- <HeroIndex /> -->
  <!-- <Experience /> -->
  <!-- <ListProjects /> -->
</Layout>
