---
interface Props {
  schedule: {
    hora: string;
    tema: string;
    ponente: string;
    dia: string;
  }[];
}

const { schedule } = Astro.props;
---

<div class="hidden sm:block overflow-x-auto">
  <table
    class="min-w-full divide-y shadow-lg
                  divide-purple-200 dark:divide-purple-800
                  border-purple-200 dark:border-purple-800"
  >
    <thead>
      <tr class="bg-purple-700 text-white dark:bg-purple-900">
        <th
          scope="col"
          class="px-6 py-3 text-left text-sm font-semibold uppercase tracking-wider rounded-tl-xl"
        >
          Hora
        </th>
        <th
          scope="col"
          class="px-6 py-3 text-left text-sm font-semibold uppercase tracking-wider"
        >
          Tema
        </th>
        <th
          scope="col"
          class="px-6 py-3 text-left text-sm font-semibold uppercase tracking-wider"
        >
          Ponente
        </th>
        <th
          scope="col"
          class="px-6 py-3 text-left text-sm font-semibold uppercase tracking-wider rounded-tr-xl"
        >
          Día
        </th>
      </tr>
    </thead>
    <tbody
      class="divide-y
                    bg-white dark:bg-gray-800
                    divide-purple-100 dark:divide-purple-900"
    >
    {
      schedule &&
      schedule.map((item, index) => (
        <tr
          class:list={[
            "transition duration-150 ease-in-out",
            // Estilos de fila para modo claro
            index % 2 === 0
              ? "bg-purple-50 hover:bg-purple-100"
              : "bg-white hover:bg-purple-100/70",
            // Estilos de fila para modo oscuro (dark:)
            index % 2 === 0
              ? "dark:bg-gray-700 dark:hover:bg-gray-600"
              : "dark:bg-gray-800 dark:hover:bg-gray-700/70",
          ]}
        >
          <td
            class="px-6 py-4 whitespace-nowrap text-lg font-extrabold 
                        text-purple-800 dark:text-purple-300"
          >
            {item.hora}
          </td>
          <td
            class="px-6 py-4 text-sm font-medium max-w-lg
                        text-gray-900 dark:text-gray-100"
          >
            {item.tema}
          </td>
          <td
            class="px-6 py-4 whitespace-nowrap text-sm italic
                        text-gray-600 dark:text-gray-400"
          >
            {item.ponente}
          </td>
          <td
            class="px-6 py-4 whitespace-nowrap text-sm font-semibold
                        text-purple-600 dark:text-purple-400"
          >
            {item.dia}
          </td>
        </tr>
      ))
    }
    </tbody>
  </table>
</div>
