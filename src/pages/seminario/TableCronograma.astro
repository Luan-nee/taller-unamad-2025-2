---
interface Props {
  schedule: {
    dia: string;
    hora: string;
    tema: string;
    ponente: string;
  }[];
}

const { schedule } = Astro.props;
---

<div class="space-y-6 sm:hidden">
  {schedule &&
    schedule.map((item) => (
      <div
        class="rounded-xl shadow-lg border-t-4 border-purple-500 p-5 
                  transition duration-300 hover:shadow-xl
                  bg-white dark:bg-gray-800 dark:shadow-2xl"
      >
        <div
          class="flex items-center justify-between mb-3 border-b pb-2 
                    border-purple-100 dark:border-purple-900"
        >
          <p
            class="text-xs font-semibold uppercase 
                    text-purple-700 dark:text-purple-300"
          >
            {item.dia}
          </p>
          <p
            class="font-bold 
                    text-purple-800 bg-purple-100 
                    dark:text-gray-900 dark:bg-purple-300
                    px-3 py-1 rounded-full"
          >
            {item.hora}
          </p>
        </div>
        <h2
          class="text-xl font-semibold mb-2 leading-snug
                    text-gray-800 dark:text-gray-100"
        >
          {item.tema}
        </h2>
        <p
          class="text-sm italic mt-3 pt-2 border-t 
                   text-gray-600 dark:text-gray-400
                   border-gray-100 dark:border-gray-700"
        >
          <span
            class="font-medium 
                        text-purple-600 dark:text-purple-400"
          >
            Ponente:
          </span>{" "}
          {item.ponente}
        </p>
      </div>
    ))
  }
</div>
